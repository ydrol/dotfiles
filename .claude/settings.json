{
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "env": {
    "NODE_USE_ENV_PROXY": "1"
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "www.servicenow.com",
        "*.servicenow.com",
        "*.service-now.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(pyright:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git checkout:*)",
      "Bash(grep:*)",
      "Bash(find:*)"
    ]
  }
}
