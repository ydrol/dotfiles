{
  "env": {
    "NODE_USE_ENV_PROXY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pyright:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git --no-pager show:*)",
      "Bash(git checkout:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(pytest:*)",
      "Bash(python snowdrift.pyz:*)",
      "Bash(python snowdrift.py:*)",
      "Skill(code-review)",
      "Skill(update-config)",
      "Skill(fewer-permission-prompts)",
      "Workflow(code-review)",
      "WebSearch",
      "Read(//tmp/claude/**)",
      "Read(~/.ssh/config)",
      "Read(~/.ssh/known_hosts)",
      "Bash(now-sdk:*)",
      "Bash(snowdrift:*)"
    ]
  },
  "model": "fable[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/sn-write-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh 'Claude needs input'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh 'Claude finished'"
          }
        ]
      }
    ]
  },
  "defaultShell": "bash",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "www.servicenow.com",
        "*.servicenow.com",
        "*.service-now.com",
        "127.0.0.1:46000",
        "127.0.0.1:46500",
        "127.0.0.1:47000",
        "127.0.0.1:47500"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/servicenow-doc-md-reader"
      ],
      "allowRead": [
        "~/.ssh/known_hosts",
        "/home/lordy/work/bitbucket/h3g-uiv-test-harness/node_modules/**"
      ]
    },
    "excludedCommands": [
      "now-sdk",
      "snowdrift"
    ]
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto"
}
