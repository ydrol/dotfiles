{
  "env": {
    "NODE_USE_ENV_PROXY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pyright:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git --no-pager show:*)",
      "Bash(git checkout:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(pytest:*)",
      "Bash(python snowdrift.pyz:*)",
      "Bash(python snowdrift.py:*)",
      "Skill(code-review)",
      "Skill(update-config)",
      "Skill(fewer-permission-prompts)",
      "Workflow(code-review)",
      "WebSearch",
      "Read(//tmp/claude/**)",
      "Read(~/.ssh/config)",
      "Read(~/.ssh/known_hosts)",
      "Bash(now-sdk:*)",
      "Bash(snowdrift:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh 'Claude needs input'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh 'Claude finished'"
          }
        ]
      }
    ]
  },
  "defaultShell": "bash",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "www.servicenow.com",
        "*.servicenow.com",
        "*.service-now.com"
      ]
    },
    "filesystem": {
      "allowRead": [
        "~/.ssh/known_hosts"
      ]
    },
    "excludedCommands": [
      "now-sdk",
      "snowdrift"
    ]
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto"
}
