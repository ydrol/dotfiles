{
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "plansDirectory":"~/.claude/plans",
  "env": {
    "NODE_USE_ENV_PROXY": "1"
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "www.servicenow.com",
        "*.servicenow.com",
        "*.service-now.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(pyright:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git --no-pager show:*)",
      "Bash(git checkout:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(pytest:*)",
      "Skill(code-review)",
      "Skill(update-config)",
      "Skill(fewer-permission-prompts)",
      "Workflow(code-review)",
      "WebSearch",
      "Read(//tmp/claude/**)"
    ]
  }
}
